{
  "name": "kgllm",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8080 --strictPort",
    "build": "vite build",
    "start": "node scripts/lifecycle.mjs start",
    "stop": "node scripts/lifecycle.mjs stop",
    "test": "npm run build && node --test --test-concurrency=1 \"test/*.test.js\"",
    "test:browser": "npm run build && node --test --test-concurrency=1 browser/browser.spec.mjs"
  },
  "dependencies": {
    "express": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "playwright-core": "1.65.1",
    "vite": "8.3.8"
  }
}
